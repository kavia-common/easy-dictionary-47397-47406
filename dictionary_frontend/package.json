{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "NUXT_TELEMETRY_DISABLED=1 NUXT_TYPE_CHECK=0 nuxt dev --host 0.0.0.0 --port ${NUXT_PUBLIC_PORT:-${PORT:-${NITRO_PORT:-3000}}} --no-open",
    "generate": "nuxt generate",
    "preview": "NUXT_TELEMETRY_DISABLED=1 nuxt preview --port ${NUXT_PUBLIC_PORT:-${PORT:-${NITRO_PORT:-3000}}}",
    "lint": "eslint ."
  },
  "dependencies": {
    "nuxt": "^3.16.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nuxt/eslint-config": "^0.2.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
